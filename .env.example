# Copy to .env and fill in the values.
# Windows PowerShell: load these values manually or use a dotenv-capable shell.
# Linux/macOS: set -a; source .env; set +a
SPRING_PROFILES_ACTIVE=dev

DB_URL=jdbc:mysql://localhost:3306/bank?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=bank
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=

# 32 random bytes, base64 encoded:  openssl rand -base64 32
APP_DATA_KEY=
# Long random string used to pepper PIN hashes:  openssl rand -base64 48
APP_PIN_PEPPER=

# Shown on the Privacy Policy and Terms pages
APP_OPERATOR_NAME=
APP_CONTACT_EMAIL=
APP_JURISDICTION=
APP_PUBLIC_URL=http://localhost:8080

# Optional
# APP_BRAND_NAME=Bank Management System
# APP_DEMO_MODE=true
